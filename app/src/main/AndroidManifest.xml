<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- HMS Core permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Health Kit permissions -->
    <uses-permission android:name="com.huawei.hms.permission.HEALTHKIT_STEP_BOTH" />
    <uses-permission android:name="com.huawei.hms.permission.HEALTHKIT_HEARTRATE_BOTH" />
    <uses-permission android:name="com.huawei.hms.permission.HEALTHKIT_HEIGHTWEIGHT_BOTH" />

    <application
        android:name=".PulseApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pulse"
        tools:targetApi="34">

        <!-- Huawei App ID - replace YOUR_APP_ID with your actual App ID from AppGallery Connect -->
        <meta-data
            android:name="com.huawei.hms.client.app_id"
            android:value="YOUR_APP_ID" />

        <!-- HMS Core auto-initialization -->
        <meta-data
            android:name="com.huawei.hms.client.auto_init"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Pulse">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
